{
  "name": "collab-editor",
  "version": "2.0.0",
  "description": "A bounded, ephemeral collaborative snippet editor with server-authoritative OT",
  "type": "module",
  "main": "server/server.js",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server/server.js",
    "dev": "npm run build && node --watch server/server.js",
    "test": "npm run build && node --test tests/unit.test.js tests/integration.test.js",
    "test:e2e": "playwright test",
    "demo": "node scripts/demo.mjs",
    "check": "npm test && npm run test:e2e && npm run demo"
  },
  "engines": { "node": ">=24.21.0 <25", "npm": ">=11.19.0 <12" },
  "packageManager": "npm@11.19.0",
  "keywords": ["collaborative-editor", "socketio", "operational-transformation", "codemirror"],
  "author": "Dhruv Chamria",
  "license": "MIT",
  "dependencies": {
    "@codemirror/collab": "6.1.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "codemirror": "6.0.2",
    "express": "5.2.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2"
  }
}
